{
  "manifest_version": 3,
  "name": "CodeHub - Multi-Platform Solution Pusher",
  "version": "1.0.0",
  "description": "Push your coding solutions to GitHub from LeetCode, Codeforces, HackerRank, CodeChef, and Codewars",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://codeforces.com/*",
    "https://www.hackerrank.com/*",
    "https://www.codechef.com/*",
    "https://www.codewars.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://codeforces.com/problemset/problem/*",
        "https://www.hackerrank.com/challenges/*",
        "https://www.codechef.com/problems/*",
        "https://www.codewars.com/kata/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}